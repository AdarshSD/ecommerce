# Database
# macOS brew default: no password, username = your macOS username
DATABASE_URL=postgresql+asyncpg://adarsh@localhost:5432/leafandlore

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_generated_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local file storage (P1/P2)
STORAGE_BACKEND=local
MEDIA_ROOT=./media
MEDIA_BASE_URL=http://localhost:8000/media

# First admin user (used by seed/seed_admin.py)
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=choose_a_strong_password
FIRST_ADMIN_FIRST_NAME=Admin
FIRST_ADMIN_LAST_NAME=User

# CORS
FRONTEND_URL=http://localhost:3000

# App
ENVIRONMENT=development
